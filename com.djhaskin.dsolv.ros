#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -Q -- $0 "$@"
|#
(progn
  (ros:ensure-asdf)
  (asdf:load-asd "/home/skin/Code/djha-skin/dsolv/com.djhaskin.dsolv.asd")
  (asdf:load-system :com.djhaskin.dsolv))

(defpackage :ros.script.com.djhaskin.dsolv
  (:use :cl))
(in-package :ros.script.com.djhaskin.dsolv)

(defun main (&rest argv)
  (sb-ext:exit
    :code
    (nth-value 0
      (apply #'com.djhaskin.dsolv:main argv))))