#!/bin/sh
#
# goosew — Launch goose with the cl-mcp extension loaded.
#
# Reads extension configuration from .pi/mcp.json (Streamable HTTP format)
# and passes it to `goose session --with-streamable-http-extension`.
#
# Usage:  ./scripts/goosew [goose arguments...]
#         ./scripts/goosew session          # start an interactive session
#         ./scripts/goosew "prompt text"    # run a one-shot prompt
#

set -euo pipefail
export POSIXLY_CORRECT=1

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
project_root="$(cd "$script_dir/.." && pwd)"
export GOOSE_MOIM_MESSAGE_FILE=$project_root/.agents/top-of-mind.md

goose_cmd="goose session"

for cmd_extension in \
    $(cat .agents/mcp.json \
    | jq -r '.mcpServers |
        keys[] as $k |
        .[$k] |
        select(has("command")) |
        "goose://extension?id=\($k | @uri)&name=\($k | @uri)\(if .description then "&description=\(.description | @uri)" else "" end)&cmd=\(.command | @uri)\(if .args then "&arg=\(.args | map(@uri) | join("&arg="))" else "" end)"')
do
    goose_cmd="${goose_cmd} --with-linked-extension ${cmd_extension}"
done


for http_extension in \
    $(cat .agents/mcp.json \
    | jq -r '.mcpServers |
        keys[] as $k |
        .[$k] |
        select(has("url")) |
        "goose://extension?type=streamable_http&id=\($k | @uri)&name=\($k | @uri)\(if .description then "&description=\(.description | @uri)" else "" end)&url=\(.url | @uri)"')
do
    goose_cmd="${goose_cmd} --with-linked-extension ${http_extension}"
done

${goose_cmd} "${@}"